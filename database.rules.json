{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email === 'admin@nishant.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nishant.com')",
        ".write": "auth != null && auth.uid === $uid",
        "bmcEntries": {
          ".indexOn": ["date"]
        }
      }
    },
    "passbookAttempts": {
      ".read": false,
      ".write": false
    },
    "subscriptions": {
      ".read": "auth != null && auth.token.email === 'admin@nishant.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nishant.com')",
        ".write": "auth != null && auth.token.email === 'admin@nishant.com'"
      }
    },
    "globalRateConfig": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'admin@nishant.com'"
    },
    "rateCharts": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'admin@nishant.com'"
    },

    "societyCodeIndex": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && ((newData.exists() && newData.val() === auth.uid && (!data.exists() || data.val() === auth.uid)) || (!newData.exists() && data.exists() && data.val() === auth.uid))"
      }
    },

    "whatsappRechargeRequests": {
      ".read": "auth != null && auth.token.email === 'admin@nishant.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nishant.com')",
        ".write": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nishant.com')"
      }
    },

    "whatsappWallets": {
      ".read": "auth != null && auth.token.email === 'admin@nishant.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nishant.com')",
        ".write": "auth != null && auth.token.email === 'admin@nishant.com'"
      }
    },

    "whatsappConfig": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'admin@nishant.com'"
    },

    ".read": false,
    ".write": false
  }
}
