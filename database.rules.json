{
  "rules": {
    "users": {
      ".read": "auth != null && auth.token.email === 'admin@nishant.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nishant.com')",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "subscriptions": {
      ".read": "auth != null && auth.token.email === 'admin@nishant.com'",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.email === 'admin@nishant.com')",
        ".write": "auth != null && auth.token.email === 'admin@nishant.com'"
      }
    },
    "globalRateConfig": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email === 'admin@nishant.com'"
    },
    ".read": false,
    ".write": false
  }
}
