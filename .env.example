# Copy this file to ".env" and fill in real values.
# These are read at build time by Vite (variables MUST start with VITE_).
# Do NOT commit the real ".env" file.

# Optional: used only to bootstrap the admin account if it does not exist yet.
# Leave blank in normal operation (the admin account already exists in Firebase).
VITE_ADMIN_EMAIL=
VITE_ADMIN_PASSWORD=

# MSG91 SMS credentials. Preferred way is to configure these from the in-app
# Settings page (stored per-user in Firebase). These env values are only used
# as a fallback when nothing is configured in Settings.
VITE_MSG91_AUTH_KEY=
VITE_MSG91_TEMPLATE_ID=
